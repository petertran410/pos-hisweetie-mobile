{
  "expo": {
    "name": "POS",
    "slug": "pos-hisweetie-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/logo-lermao.png",
    "scheme": "hisweetiepos",
    "userInterfaceStyle": "light",
    "ios": {
      "icon": "./assets/images/logo-lermao.png",
      "bundleIdentifier": "com.hisweetievietnam.pos",
      "supportsTablet": false,
      "infoPlist": {
        "CFBundleDevelopmentRegion": "vi",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.hisweetievietnam.pos",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/logo-lermao.png",
        "backgroundImage": "./assets/images/logo-lermao.png",
        "monochromeImage": "./assets/images/logo-lermao.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/logo-lermao.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FFFFFF",
          "image": "./assets/images/logo-lermao.png",
          "imageWidth": 76
        }
      ],
      "expo-secure-store",
      "expo-sharing",
      "@react-native-community/datetimepicker",
      [
        "expo-camera",
        {
          "cameraPermission": "HiSweetie POS dùng camera để quét mã vạch sản phẩm, quét mã QR chứng từ và chụp ảnh báo đơn.",
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "HiSweetie POS dùng ảnh trong máy để đính kèm vào báo đơn và hàng hóa.",
          "cameraPermission": "HiSweetie POS dùng camera để quét mã vạch sản phẩm, quét mã QR chứng từ và chụp ảnh báo đơn.",
          "microphonePermission": false
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "buildArchs": ["arm64-v8a"]
          }
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/notification-icon.png",
          "color": "#0B7A87"
        }
      ],
      "./modules/lark-sso/app.plugin.js"
    ],
    "experiments": {
      "typedRoutes": false,
      "reactCompiler": true
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "f74e1fdc-e813-42e3-94f9-809f7fac3b8d"
      }
    },
    "owner": "petertran410",
    "runtimeVersion": {
      "policy": "fingerprint"
    },
    "updates": {
      "url": "https://u.expo.dev/f74e1fdc-e813-42e3-94f9-809f7fac3b8d"
    }
  }
}
