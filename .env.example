# Sao chép file này thành `.env` (không commit `.env`) rồi điền giá trị thật.
# Biến EXPO_PUBLIC_* được đóng vào app khi build: KHÔNG đặt mật khẩu, khoá bí mật
# hay token vào đây. App chỉ cần địa chỉ API; mọi quyền truy cập đi qua đăng nhập.

# Địa chỉ API backend (có /api ở cuối). Bản phát hành bắt buộc https://
EXPO_PUBLIC_API_URL=https://your-backend.example.com/api
